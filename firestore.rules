rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function callerMember() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    // True when the caller's authoritative member doc places them in circleId.
    function inCircle(circleId) {
      return isSignedIn() && callerMember().circleId == circleId;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Circles collection
    // Readable ONLY by members of that circle: keeps the passcode hash and
    // the elder's details private to the circle. createdBy binds each circle
    // to the account that created it; only that account may hold elder role.
    match /circles/{circleId} {
      allow read: if inCircle(circleId);
      allow create: if isSignedIn()
        && request.resource.data.circleId == circleId
        && request.resource.data.elderName is string
        && request.resource.data.passcodeHash is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(
          ['circleId', 'elderName', 'passcodeHash', 'createdBy', 'createdAt', 'createdAtServer', 'backupCaretakerId']);
      allow update, delete: if false;
    }

    // Members collection
    // Joining a circle requires proving knowledge of the circle passcode:
    // the client sends joinProof = hashPasscode(passcode) and the server
    // compares it with the circle's stored passcodeHash. Without the
    // passcode nobody can add themselves to a circle. The elder role is
    // reserved for the circle's creator. joinProof is transient: the client
    // removes it immediately after the write and updates may never set it.
    match /members/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        callerMember().circleId == resource.data.circleId
      );
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.memberId == uid
        && request.resource.data.role in ['elder', 'caretaker', 'family']
        && request.resource.data.circleId is string
        && request.resource.data.keys().hasOnly(
          ['memberId', 'circleId', 'name', 'email', 'phone', 'role', 'status', 'joinProof', 'createdAtServer'])
        && exists(/databases/$(database)/documents/circles/$(request.resource.data.circleId))
        && get(/databases/$(database)/documents/circles/$(request.resource.data.circleId)).data.passcodeHash == request.resource.data.joinProof
        && (request.resource.data.role != 'elder'
          || get(/databases/$(database)/documents/circles/$(request.resource.data.circleId)).data.createdBy == request.auth.uid);
      // Only profile fields may change. Role, circle, identity and every
      // privileged or proof field are immutable: any change to them appears
      // in affectedKeys and is rejected.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'joinProof'])
        && !request.resource.data.keys().hasAny(['joinProof']);
      allow delete: if false;
    }

    // Medications collection
    match /medications/{medicationId} {
      allow get, list: if inCircle(resource.data.circleId);
      allow create: if isSignedIn()
        && callerMember().role in ['caretaker', 'elder']
        && callerMember().circleId == request.resource.data.circleId
        && request.resource.data.name is string
        && request.resource.data.scheduledTimes is list;
      allow update: if isSignedIn()
        && callerMember().role in ['caretaker', 'elder']
        && callerMember().circleId == resource.data.circleId
        && callerMember().circleId == request.resource.data.circleId;
      allow delete: if isSignedIn()
        && callerMember().role in ['caretaker', 'elder']
        && callerMember().circleId == resource.data.circleId;
    }

    // Dose Events collection
    // create and update are separate so an update can never reassign an
    // existing event to another circle or overwrite a foreign event by ID:
    // both the existing and the incoming circle must be the caller's own.
    match /doseEvents/{eventId} {
      allow get, list: if inCircle(resource.data.circleId);
      allow create: if isSignedIn()
        && callerMember().role in ['elder', 'caretaker']
        && callerMember().circleId == request.resource.data.circleId
        && request.resource.data.status in ['taken', 'skipped', 'uncertain', 'overdue', 'unconfirmed'];
      allow update: if isSignedIn()
        && callerMember().role in ['elder', 'caretaker']
        && callerMember().circleId == resource.data.circleId
        && callerMember().circleId == request.resource.data.circleId
        && request.resource.data.status in ['taken', 'skipped', 'uncertain', 'overdue', 'unconfirmed'];
      allow delete: if false;
    }

    // Appointments collection (Phase 2)
    match /appointments/{appointmentId} {
      allow get, list: if inCircle(resource.data.circleId);
      allow create: if isSignedIn()
        && callerMember().role in ['caretaker', 'elder']
        && callerMember().circleId == request.resource.data.circleId
        && request.resource.data.title is string
        && request.resource.data.date is string;
      allow update: if isSignedIn()
        && callerMember().role in ['caretaker', 'elder']
        && callerMember().circleId == resource.data.circleId
        && callerMember().circleId == request.resource.data.circleId;
      allow delete: if isSignedIn()
        && callerMember().role in ['caretaker', 'elder']
        && callerMember().circleId == resource.data.circleId;
    }

    // Care Handoff Alerts collection (Phase 2)
    match /careAlerts/{alertId} {
      allow get, list: if inCircle(resource.data.circleId);
      allow create: if isSignedIn()
        && callerMember().role in ['caretaker', 'elder']
        && callerMember().circleId == request.resource.data.circleId;
      // Both the existing and the incoming circle must be the caller's own,
      // so an alert can never be moved out of (or into) another circle.
      allow update: if isSignedIn()
        && callerMember().role == 'caretaker'
        && callerMember().circleId == resource.data.circleId
        && callerMember().circleId == request.resource.data.circleId;
      allow delete: if false;
    }

    // Care Activities (Audit Trail) collection (Phase 2)
    match /careActivities/{activityId} {
      allow get, list: if inCircle(resource.data.circleId);
      allow create: if isSignedIn()
        && callerMember().circleId == request.resource.data.circleId
        && request.resource.data.details is string;
      allow update, delete: if false; // Immutable audit trail
    }

    // Reminder Logs collection (Phase 2)
    match /reminderLogs/{reminderId} {
      allow get, list: if inCircle(resource.data.circleId);
      allow create: if isSignedIn()
        && callerMember().circleId == request.resource.data.circleId;
      allow update, delete: if false;
    }

    // Contact Inquiries collection (Phase 2)
    // Public create stays (landing-page contact form). Read/update are
    // fail-closed for EVERYONE until a verified admin identity is set up:
    // any pre-existing role/isAdmin flag could have been minted under the
    // old permissive rules, so it is not trusted for inbox access.
    match /contactInquiries/{inquiryId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10;
      allow read, update: if false;
      allow delete: if false;
    }
  }
}
